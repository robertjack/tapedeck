{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tapedeck/meta",
  "title": "tapedeck video metadata (library/<id>/meta.json)",
  "type": "object",
  "required": ["id", "title", "channel", "upload_date", "duration_s", "url"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "title": { "type": "string", "minLength": 1 },
    "channel": { "type": "string" },
    "upload_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "duration_s": { "type": "integer", "minimum": 0 },
    "url": { "type": "string" },
    "description": { "type": "string" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "start_s"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "start_s": { "type": "number", "minimum": 0 }
        }
      }
    },
    "ingested_at": { "type": "string" }
  }
}
